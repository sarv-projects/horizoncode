{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/plan-handoff-v1",
  "title": "PlanHandoffV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffId",
    "planRevision",
    "objective",
    "inScope",
    "outOfScope",
    "assumptions",
    "decisions",
    "tasks",
    "importantRefs",
    "hazards",
    "unresolvedQuestions",
    "createdByProfileRevision",
    "sourceContextDigest",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "handoffId": {
      "type": "string"
    },
    "planRevision": {
      "type": "integer",
      "minimum": 1
    },
    "goalRef": {
      "type": "string"
    },
    "specRef": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "inScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceRefs"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "rationale",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskKey",
          "objective",
          "dependsOn",
          "expectedChangedScope",
          "acceptanceCriteria",
          "evidenceRefs"
        ],
        "properties": {
          "taskKey": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "expectedChangedScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "importantRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "symbol",
              "file",
              "artifact",
              "doc"
            ]
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "hazards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolvedQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdByProfileRevision": {
      "type": "string"
    },
    "sourceContextDigest": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    }
  }
}
