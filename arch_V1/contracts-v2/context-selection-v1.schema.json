{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/context-selection-v1",
  "title": "ContextSelectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionID", "mode", "sourceRevision", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionID": { "type": "string", "maxLength": 132, "pattern": "^ses_[A-Za-z0-9_-]{1,128}$" },
    "mode": { "enum": ["fresh", "conversation_slice", "fork"] },
    "sourceRevision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "format": "horizon-u64-decimal",
      "description": "Strict u64 upper-bound check is enforced by the decoder."
    },
    "sources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "messageID", "contentDigest"],
        "properties": {
          "kind": { "const": "session-message" },
          "messageID": { "type": "string", "pattern": "^msg_" },
          "contentDigest": { "type": "string", "pattern": "^(sha256|blake3):[0-9a-f]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "fresh" } }, "required": ["mode"] },
      "then": { "properties": { "sources": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "mode": { "enum": ["conversation_slice", "fork"] } }, "required": ["mode"] },
      "then": { "properties": { "sources": { "minItems": 1 } } }
    }
  ],
  "x-horizon-validation": ["u64-sourceRevision", "unique-messageID-in-source-order"]
}
