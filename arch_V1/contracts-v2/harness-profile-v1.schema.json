{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/harness-profile-v1",
  "title": "HarnessProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "harnessId",
    "revision",
    "displayName",
    "source",
    "supportedWireApis",
    "systemPromptRef",
    "toolProjection",
    "messageCodecId",
    "responseCodecId",
    "structuredCallPolicyId",
    "contextPolicyId",
    "outputPolicyId",
    "capabilityRequirements",
    "definitionDigest"
  ],
  "properties": {
    "harnessId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
      "description": "Unsigned 64-bit JSON counter/budget; encoded as canonical decimal string."
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "builtin",
        "user",
        "project",
        "plugin"
      ]
    },
    "supportedWireApis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "responses",
          "chat_completions",
          "anthropic_messages",
          "custom"
        ]
      }
    },
    "systemPromptRef": {
      "type": "string",
      "minLength": 1
    },
    "toolProjection": {
      "type": "string",
      "minLength": 1,
      "description": "Examples: native_rich, minimal, bash_only, compatibility:<name>"
    },
    "messageCodecId": {
      "type": "string",
      "minLength": 1
    },
    "responseCodecId": {
      "type": "string",
      "minLength": 1
    },
    "structuredCallPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "contextPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "outputPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "capabilityRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "definitionDigest": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
