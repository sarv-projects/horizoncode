{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizoncode.dev/contracts/search-secret-attempt-receipt-v1.schema.json",
  "title": "HorizonCode Guarded search SecretBroker attempt receipt v1",
  "description": "HostKernel-owned per-route state receipt. It contains no credential bytes, SecretBroker lease, response body, or caller-selected destination. Provider status, bounded result count, and body digest are reported by the authenticated Core sender after its fixed in-process transport. NOT_DISPATCHED is valid only when the trusted transport proves no request bytes left the process; it has no HTTP status or response metadata and permits at most one same-route retry. Any ambiguity after possible send is UNKNOWN. EMPTY is valid only for a complete 2xx response whose recognized provider result array contains zero rows; it is terminal for that route and is never retried.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptRef",
    "attemptDigest",
    "routeKey",
    "attempt",
    "outcome",
    "httpStatus",
    "retryAfterMs",
    "resultCount",
    "bodyDigest",
    "bodyBytes",
    "responseComplete",
    "settledAtUnixMs",
    "receiptDigest",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "attemptRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "attemptDigest": {
      "$ref": "execution-launch-profile-v1.schema.json#/$defs/Digest"
    },
    "routeKey": {
      "enum": [
        "brave",
        "exa",
        "youcom",
        "tavily",
        "firecrawl",
        "parallel"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "outcome": {
      "enum": [
        "NOT_DISPATCHED",
        "SUCCEEDED",
        "FAILED",
        "RATE_LIMITED",
        "RETRYABLE_FAILURE",
        "EMPTY"
      ]
    },
    "httpStatus": {
      "type": ["integer", "null"],
      "minimum": 100,
      "maximum": 599
    },
    "retryAfterMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 60000
    },
    "resultCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 10
    },
    "bodyDigest": {
      "anyOf": [
        {
          "$ref": "execution-launch-profile-v1.schema.json#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "bodyBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2097152
    },
    "responseComplete": {
      "type": "boolean"
    },
    "settledAtUnixMs": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
      "description": "Unsigned 64-bit JSON counter/budget; encoded as canonical decimal string."
    },
    "receiptDigest": {
      "$ref": "execution-launch-profile-v1.schema.json#/$defs/Digest"
    },
    "status": {
      "const": "SETTLED"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "NOT_DISPATCHED" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "httpStatus": { "type": "null" },
          "retryAfterMs": { "type": "null" },
          "resultCount": { "type": "null" },
          "bodyDigest": { "type": "null" },
          "bodyBytes": { "const": 0 },
          "responseComplete": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "EMPTY" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "httpStatus": { "type": "integer", "minimum": 200, "maximum": 299 },
          "resultCount": { "const": 0 },
          "responseComplete": { "const": true }
        }
      }
    }
  ]
}
