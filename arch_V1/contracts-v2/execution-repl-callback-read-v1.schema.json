{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizoncode.dev/contracts/execution-repl-callback-read-v1.schema.json",
  "title": "ExecutionReplCallbackReadV1",
  "description": "Authenticated bounded read of callbacks emitted by one retained interpreter generation. The cursor grants no callback or tool authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/page"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^blake3:[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "hostProcessRef": {
      "type": "object",
      "description": "Strict StdioProcessRefV1 of kind interpreter; includes owner epoch, generation, launch effect/challenge, profile and executable pins."
    },
    "scope": {
      "oneOf": [
        {
          "required": [
            "managedAttempt"
          ],
          "not": {
            "required": [
              "directAttempt"
            ]
          }
        },
        {
          "required": [
            "directAttempt"
          ],
          "not": {
            "required": [
              "managedAttempt"
            ]
          }
        }
      ]
    },
    "callback": {
      "type": "object",
      "required": [
        "eventSequence",
        "generation",
        "callbackID",
        "capabilityID",
        "arguments"
      ],
      "properties": {
        "eventSequence": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "generation": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "callbackID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "capabilityID": {
          "$ref": "#/$defs/id"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 4096
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "schemaVersion",
        "hostProcessRef",
        "sessionID",
        "locationID",
        "workspaceRevision",
        "afterEventSequence",
        "maxEvents",
        "maxBytes"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "hostProcessRef": {
          "$ref": "#/$defs/hostProcessRef"
        },
        "sessionID": {
          "$ref": "#/$defs/id"
        },
        "locationID": {
          "$ref": "#/$defs/id"
        },
        "workspaceRevision": {
          "$ref": "#/$defs/digest"
        },
        "afterEventSequence": {
          "$ref": "#/$defs/decimal"
        },
        "maxEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "managedAttempt": {
          "type": "object"
        },
        "directAttempt": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "managedAttempt"
          ],
          "not": {
            "required": [
              "directAttempt"
            ]
          }
        },
        {
          "required": [
            "directAttempt"
          ],
          "not": {
            "required": [
              "managedAttempt"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "eventSequence",
        "callback"
      ],
      "properties": {
        "eventSequence": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "callback": {
          "$ref": "#/$defs/callback"
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "schemaVersion",
        "hostProcessRef",
        "afterEventSequence",
        "nextEventSequence",
        "processIOSequence",
        "workspaceRevision",
        "status",
        "resnapshotRequired",
        "events"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "hostProcessRef": {
          "$ref": "#/$defs/hostProcessRef"
        },
        "afterEventSequence": {
          "$ref": "#/$defs/decimal"
        },
        "nextEventSequence": {
          "$ref": "#/$defs/decimal"
        },
        "processIOSequence": {
          "$ref": "#/$defs/decimal"
        },
        "workspaceRevision": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": [
            "RUNNING",
            "EXITED",
            "UNKNOWN"
          ]
        },
        "resnapshotRequired": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
