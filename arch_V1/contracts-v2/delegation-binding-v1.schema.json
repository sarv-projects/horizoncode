{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/delegation-binding-v1",
  "title": "DelegationBindingV1",
  "description": "Private Rust-owned immutable authority binding minted from accepted Goal, Task, live Attempt and current leases. No request body may establish these fields.",
  "$comment": "The u64-positive-decimal-string format is enforced by the strict Rust decoder, including canonical spelling, nonzero values, and the full u64::MAX range. capabilityCeilingDigest is SHA-256 of the canonical sorted effective capability ceiling, not a lease digest. permissionScopeDigest is the BLAKE3 digest under horizoncode.effective-permission-scope.v1 of canonical MessagePack provenance (Attempt ID/epoch, accepted scope digest, profile identity/permission digests, current Guard policy revision) and the sorted unique concrete effective capability intersection; it is distinct from the profile ceiling and capability lease. Admission fails when either scope cannot be resolved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runID",
    "taskID",
    "attemptID",
    "parentExecutionID",
    "childExecutionID",
    "acceptedSpecDigest",
    "profileID",
    "profileRevision",
    "profileDigest",
    "providerID",
    "modelID",
    "profileTokenBudget",
    "criteriaIDs",
    "workspaceLeaseID",
    "sourceRevision",
    "capabilityCeilingDigest",
    "permissionScopeDigest",
    "contextSelectionDigest",
    "budgetLeaseID",
    "resourceLeaseIDs",
    "ownerEpoch",
    "admittedManagedRevision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runID": {
      "$ref": "#/$defs/id"
    },
    "taskID": {
      "$ref": "#/$defs/id"
    },
    "attemptID": {
      "$ref": "#/$defs/id"
    },
    "parentExecutionID": {
      "$ref": "#/$defs/id"
    },
    "childExecutionID": {
      "$ref": "#/$defs/id"
    },
    "acceptedSpecDigest": {
      "$ref": "#/$defs/blake3"
    },
    "profileID": {
      "$ref": "#/$defs/id"
    },
    "profileRevision": {
      "$ref": "#/$defs/counter"
    },
    "profileDigest": {
      "$ref": "#/$defs/blake3"
    },
    "providerID": {
      "$ref": "#/$defs/providerModelID"
    },
    "modelID": {
      "$ref": "#/$defs/providerModelID"
    },
    "managedProviderRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerID",
        "modelID",
        "harnessID",
        "routeID",
        "endpointRevision",
        "credentialLeaseRef"
      ],
      "properties": {
        "providerID": {
          "$ref": "#/$defs/providerModelID"
        },
        "modelID": {
          "$ref": "#/$defs/providerModelID"
        },
        "harnessID": {
          "$ref": "#/$defs/id"
        },
        "routeID": {
          "$ref": "#/$defs/id"
        },
        "endpointRevision": {
          "$ref": "#/$defs/blake3"
        },
        "credentialLeaseRef": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        }
      },
      "description": "Optional only for historical bindings. New managed Attempt admissions require the exact secret-free Core Provider route projection; missing route authority makes provider dispatch unavailable."
    },
    "profileTokenBudget": {
      "$ref": "#/$defs/optionalCounter"
    },
    "criteriaIDs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "workspaceLeaseID": {
      "$ref": "#/$defs/id"
    },
    "sourceRevision": {
      "$ref": "#/$defs/blake3"
    },
    "capabilityCeilingDigest": {
      "$ref": "#/$defs/sha256",
      "description": "SHA-256 digest of the canonical sorted effective capability ceiling; not a lease digest. Admission fails if the ceiling cannot be resolved."
    },
    "permissionScopeDigest": {
      "$ref": "#/$defs/blake3",
      "description": "Attempt-bound effective permission scope digest over accepted Task/Spec scope, pinned profile permission authority, current Guard policy revision, and the sorted unique concrete effective capability intersection. Distinct from capabilityCeilingDigest and any lease digest."
    },
    "contextSelectionDigest": {
      "$ref": "#/$defs/blake3"
    },
    "budgetLeaseID": {
      "$ref": "#/$defs/id"
    },
    "resourceLeaseIDs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "ownerEpoch": {
      "$ref": "#/$defs/counter"
    },
    "admittedManagedRevision": {
      "$ref": "#/$defs/counter"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "counter": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64"
    },
    "optionalCounter": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "horizon://schemas/wire-primitives-v1#/$defs/PositiveDecimalU64"
        }
      ]
    },
    "providerModelID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "blake3": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
