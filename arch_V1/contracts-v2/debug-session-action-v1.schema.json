{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DebugSessionActionV1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "action": {
      "enum": [
        "start",
        "attach",
        "stop",
        "breakpoint_set",
        "breakpoint_remove",
        "continue",
        "pause",
        "step_over",
        "step_into",
        "step_out",
        "stack",
        "scopes",
        "variables",
        "evaluate"
      ]
    },
    "threadRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "frameRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "variableRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "expression": {
      "type": [
        "string",
        "null"
      ]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": true
    },
    "effectContextRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "sessionId",
    "generation",
    "action",
    "arguments",
    "deadlineMs"
  ],
  "additionalProperties": false
}
