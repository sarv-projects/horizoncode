    "each-newline-terminated-serialized-frame-is-at-most-2097152-UTF8-bytes-before-parse;start-frame-canonical-JSON-tools-array-is-at-most-1048576-UTF8-bytes-and-entire-start-frame-remains-within-2097152",
    "toolDefinitionsBytes-is-host-computed-canonical-JSON-UTF8-byte-count-for-tools-array;receiver-recomputes-and-exact-compares;schema-maxLength-is-character-count-only",
    "start-tool-set-is-exact-current-authorized-projection-sorted-by-capabilityId-then-toolName",
    "inputSchemaDigest-is-blake3-domain-horizon.tool-schema.v1-NUL-plus-canonical-JSON-of-schema-decoded-inputSchema",
    "toolSetDigest-is-blake3-domain-horizoncode.codemode-toolset.v1-NUL-plus-canonical-MessagePack-of-schema-decoded-tools-array-with-exact-toolName-capabilityId-description-inputSchema-and-inputSchemaDigest-fields",
    "toolSetDigest-canonical-MessagePack-map-keys-use-UTF8-byte-order-and-arrays-preserve-the-defined-capabilityId-then-toolName-sort",
    "each-wave-is-complete-and-atomic-at-ToolBatch-admission-before-any-call-dispatch",
