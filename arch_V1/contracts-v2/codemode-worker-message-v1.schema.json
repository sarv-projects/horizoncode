    "max-64-total-calls-in-at-most-64-waves-of-32;one-30000ms-monotonic-deadline-and-65536-aggregate-output-bytes",
    "Core-dispatches-wave-using-authenticated-root-direct-Session-scope,an-actual-direct-child-DirectTurnScope-when-applicable,or-live-managed-Attempt-scope;never-synthesize-an-Attempt-for-a-root-Session",
    "wave_result-results-match-the-exact-dispatched-callIds-count-and-order;every-known-terminal-result-carries-its-receiptRef-and-receiptDigest;settled-tool_result-carries-recomputed-resultDigest-and-exact-UTF8-outputBytes;effect_receipt-and-host_decision-carry-neither;UNKNOWN-carries-none",
    "settled-wave-receiptDigest-is-recomputed-from-ordered-callId-ref-digest-tuples;UNKNOWN-wave-has-at-least-one-unknown-result-and-no-wave-receiptDigest;helper-cannot-assert-settlement",
    "a-wave-containing-UNKNOWN-terminates-CodeMode-and-is-never-presented-as-settled-or-resumed;outer-dispatch-remains-UNKNOWN-until-authoritative-reconciliation",
