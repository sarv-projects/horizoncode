{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/attempt-effect-wave-bound-v1",
  "title": "AttemptEffectWaveBoundV1",
  "description": "Managed OwnerLog event for one complete ToolBatch wave. It binds exact effect identities and immutable intents before any one-use lease becomes consumable. Arguments and secret values are never persisted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runID", "taskID", "attemptID", "batchID", "waveIndex",
    "sessionID", "locationID", "sourceScopeDigest", "edges", "waveDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runID": { "$ref": "#/definitions/id" },
    "taskID": { "$ref": "#/definitions/id" },
    "attemptID": { "$ref": "#/definitions/id" },
    "batchID": { "$ref": "#/definitions/id" },
    "waveIndex": { "type": "integer", "minimum": 0, "maximum": 63 },
    "sessionID": { "$ref": "#/definitions/id" },
    "locationID": { "$ref": "#/definitions/id" },
    "sourceScopeDigest": { "$ref": "#/definitions/digest" },
    "edges": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "$ref": "#/definitions/edge" }
    },
    "waveDigest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {
      "type": "string", "pattern": "^blake3:[a-f0-9]{64}$"
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["callIndex", "callID", "effectID", "capabilityID", "argumentsDigest", "intentDigest"],
      "properties": {
        "callIndex": { "type": "integer", "minimum": 0, "maximum": 31 },
        "callID": { "$ref": "#/definitions/id" },
        "effectID": { "$ref": "#/definitions/id" },
        "capabilityID": { "$ref": "#/definitions/id" },
        "argumentsDigest": { "$ref": "#/definitions/digest" },
        "intentDigest": { "$ref": "#/definitions/digest" }
      }
    }
  },
  "x-horizon-validation": [
    "wave-digest-is-blake3-domain-horizoncode.managed-attempt-effect-wave.v1-NUL-plus-canonical-MessagePack-of-schema-decoded-event-excluding-waveDigest",
    "argumentsDigest-is-recomputed-from-canonical-tool-arguments-and-intentDigest-is-recomputed-from-complete-immutable-EffectIntent",
    "callIndex-is-unique-contiguous-in-array-order-and-callID-effectID-are-unique-within-live-Attempt",
    "all-edges-bind-at-one-OwnerLog-revision-before-any-lease-is-consumable",
    "registered-session-location-and-sourceScopeDigest-are-derived-from-authenticated-live-Attempt-scope",
    "exact-idempotent-retry-returns-original-append-result;changed-payload-under-same-delivery-conflicts",
    "legacy-attempt_effects_bound-is-replay-only-and-cannot-authorize-new-guarded-ToolBatch-waves",
    "direct-session-effects-use-DirectTurnJournal-not-this-managed-event"
  ]
}
