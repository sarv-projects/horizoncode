    "execute-existing-interpreter-in-short-lived-helper-under-existing-Rust-ExecutionHost-and-selected-cgroup-v2-ResourceProfile",
    "helper-has-no-ambient-filesystem-process-network-credential-or-registry-api-and-all-tool-rpc-is-executed-by-Core-through-existing-SessionSupervisor-and-Guard",
    "existing-ExecutionHost-supervisor-terminates-and-reaps-helper-before-outer-tool-settlement",
    "PREPARED-lease-receipt-and-UNKNOWN-reconciliation-boundary-applies-per-wave",
    "unknown-receipt-stops-execution-and-returns-UNKNOWN-never-replays-unsettled-effect",
