{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillManifestV2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "whenToUse": {
      "type": "string"
    },
    "argumentHint": {
      "type": "string"
    },
    "userInvocable": {
      "type": "boolean"
    },
    "modelInvocable": {
      "type": "boolean"
    },
    "execution": {
      "type": "string",
      "enum": [
        "inline_guidance",
        "forked_job",
        "deterministic"
      ]
    },
    "requestedAgentId": {
      "type": "string",
      "minLength": 1
    },
    "requestedModel": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "providerId": {
              "type": "string",
              "minLength": 1
            },
            "modelId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "providerId",
            "modelId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "inherit_parent"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "peer_managed"
            },
            "peerId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "peerId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "requestedEffort": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fixed",
            "inherit"
          ]
        },
        "level": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "allowedToolPatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requestedPermissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputSchema": {
      "type": "string",
      "minLength": 1
    },
    "outputSchema": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "script",
              "reference",
              "asset",
              "template"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "path",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "maxBodyTokens": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "userInvocable",
    "modelInvocable",
    "execution",
    "allowedToolPatterns",
    "requestedPermissions",
    "resources",
    "maxBodyTokens",
    "provenance"
  ],
  "additionalProperties": false
}
