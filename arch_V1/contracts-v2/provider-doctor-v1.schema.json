{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/provider-doctor-v1",
  "title": "ProviderDoctorV1",
  "description": "Provider Doctor request/result envelope (A-V2-30 §12.16).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "tier", "deadlineMs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tier": { "enum": ["offline", "catalog", "full"] },
    "providerRef": { "type": ["string", "null"], "maxLength": 128 },
    "modelRef": { "type": ["string", "null"], "maxLength": 128 },
    "harnessRef": { "type": ["string", "null"], "maxLength": 128 },
    "networkRequestLimit": { "type": "integer", "minimum": 0, "maximum": 64 },
    "deadlineMs": { "type": "integer", "minimum": 100, "maximum": 600000 },
    "spendConsentRef": { "type": ["string", "null"], "maxLength": 256 },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "outcome"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "outcome": { "enum": ["pass", "fail", "skipped", "unknown"] },
          "redactedError": { "type": ["string", "null"], "maxLength": 512 },
          "statusCode": { "type": ["integer", "null"], "minimum": 0, "maximum": 999 }
        }
      }
    }
  }
}
