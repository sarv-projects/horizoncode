{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/attempt-effect-wave-bound-v2",
  "title": "AttemptEffectWaveBoundV2",
  "description": "Managed OwnerLog event for one complete ToolBatch wave. It binds exact immutable intents and the post-append Attempt scope used by each effect before any one-use lease becomes consumable. Arguments and secret values are never persisted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runID", "taskID", "attemptID", "batchID", "waveIndex",
    "sessionID", "locationID", "sourceScopeDigest", "edges", "waveDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runID": { "$ref": "#/definitions/id" },
    "taskID": { "$ref": "#/definitions/id" },
    "attemptID": { "$ref": "#/definitions/id" },
    "batchID": { "$ref": "#/definitions/id" },
    "waveIndex": { "type": "integer", "minimum": 0, "maximum": 63 },
    "sessionID": { "$ref": "#/definitions/id" },
    "locationID": { "$ref": "#/definitions/id" },
    "sourceScopeDigest": { "$ref": "#/definitions/digest" },
    "edges": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": { "$ref": "#/definitions/edge" }
    },
    "waveDigest": { "$ref": "#/definitions/digest" }
  },
  "definitions": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {
      "type": "string", "pattern": "^blake3:[a-f0-9]{64}$"
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["callIndex", "callID", "effectID", "capabilityID", "argumentsDigest", "intentDigest", "attemptScopeDigest"],
      "properties": {
        "callIndex": { "type": "integer", "minimum": 0, "maximum": 31 },
        "callID": { "$ref": "#/definitions/id" },
        "effectID": { "$ref": "#/definitions/id" },
        "capabilityID": { "$ref": "#/definitions/id" },
        "argumentsDigest": { "$ref": "#/definitions/digest" },
        "intentDigest": { "$ref": "#/definitions/digest" },
        "attemptScopeDigest": { "$ref": "#/definitions/digest" }
      }
    }
  },
  "x-horizon-validation": [
    "waveDigest-is-blake3-domain-horizoncode.managed-attempt-effect-wave.v2-NUL-plus-canonical-MessagePack-of-schema-decoded-event-excluding-waveDigest",
    "argumentsDigest-is-recomputed-from-canonical-tool-arguments-and-intentDigest-is-recomputed-from-complete-immutable-EffectIntent",
    "attemptScopeDigest-is-the-exact-refreshed-ManagedAttempt-scope-at-boundRevision-and-is-pinned-before-any-effect-lease-or-dispatch",
    "callIndex-is-unique-contiguous-in-array-order-and-callID-effectID-are-unique-within-live-Attempt",
    "all-edges-bind-one-complete-HostKernel-approved-batch-and-one-current-managed-Attempt",
    "OwnerLog-contains-identities-and-digests-only-no-tool-arguments-or-secrets"
  ]
}
