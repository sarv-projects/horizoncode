  "components": {
    "schemas": {
      "CommandReceipt": {
        "type": "object",
        "required": [
          "entityId",
          "version",
          "eventCursor"
        ],
        "properties": {
          "entityId": {
            "type": "string"
          },
          "version": {
            "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
            "description": "Decimal-string entity revision per §12.11."
          },
          "eventCursor": {
            "type": "string"
          }
        }
      },
      "CommandError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "PinnedModel": {
        "type": "object",
        "required": [
          "providerId",
          "modelId",
          "harnessId",
          "pinned"
        ],
        "properties": {
          "providerId": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          },
          "harnessId": {
            "type": "string"
          },
          "pinned": {
            "const": true
          }
        }
      }
    }
  }
}
