    "guardChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challengeID",
        "effectID",
        "capabilityID",
        "inputDigest",
        "normalizedTargets",
        "expiresAtUnixMs",
        "policySummary",
        "origin",
        "source",
        "policyID",
        "policyDigest",
        "normalizedAction",
