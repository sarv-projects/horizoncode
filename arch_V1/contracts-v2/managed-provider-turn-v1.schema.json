{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon://schemas/managed-provider-turn-v1",
  "title": "ManagedProviderTurnV1",
  "description": "Private authenticated HostKernel/Core DTOs for rehydrating the exact latest settled provider response and closing a managed turn. Settlement may be an intermediate tool-call response; only the separate completion operation creates fresh-turn proof.",
  "oneOf": [
    {
      "$ref": "#/$defs/PrepareRequest"
    },
    {
      "$ref": "#/$defs/PrepareResponse"
    },
    {
      "$ref": "#/$defs/ResolveApprovalRequest"
    },
    {
      "$ref": "#/$defs/ResolveApprovalResponse"
    },
    {
      "$ref": "#/$defs/BeginRequest"
    },
    {
      "$ref": "#/$defs/BeginUnavailableResponse"
    },
    {
      "$ref": "#/$defs/BeginReplayResponse"
    },
    {
      "$ref": "#/$defs/BeginFreshResponse"
    },
    {
      "$ref": "#/$defs/SettleRequest"
    },
    {
      "$ref": "#/$defs/SettleResponse"
    },
    {
      "$ref": "#/$defs/UnknownRequest"
    },
    {
      "$ref": "#/$defs/UnknownResponse"
    },
    {
      "$ref": "#/$defs/InspectSettlementRequest"
    },
    {
      "$ref": "#/$defs/InspectSettlementResponse"
    },
    {
      "$ref": "#/$defs/CompleteTurnRequest"
    },
    {
      "$ref": "#/$defs/CompleteTurnResponse"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "operationDigest": {
      "type": "string",
      "pattern": "^(?:sha256|blake3):[0-9a-f]{64}$"
    },
    "revision": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64"
    },
    "requestPins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestID",
        "requestSequence",
        "contextSelectionDigest",
        "requestDigest",
        "transportRequestDigest",
        "operationDigest"
      ],
      "properties": {
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "requestSequence": {
          "$ref": "#/$defs/revision"
        },
        "contextSelectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        }
      }
    },
    "routeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerID",
        "modelID",
        "harnessID",
        "routeID",
        "endpointRevision",
        "credentialLeaseRef"
      ],
      "properties": {
        "providerID": {
          "$ref": "#/$defs/id"
        },
        "modelID": {
          "$ref": "#/$defs/id"
        },
        "harnessID": {
          "$ref": "#/$defs/id"
        },
        "routeID": {
          "$ref": "#/$defs/id"
        },
        "endpointRevision": {
          "$ref": "#/$defs/digest"
        },
        "credentialLeaseRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        }
      }
    },
    "secretUseContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requesterRef",
        "runRef",
        "profileRef",
        "purpose",
        "expiresAtUnixMs"
      ],
      "properties": {
        "requesterRef": {
          "$ref": "#/$defs/id"
        },
        "runRef": {
          "$ref": "#/$defs/id"
        },
        "profileRef": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "const": "PROVIDER_REQUEST"
        },
        "expiresAtUnixMs": {
          "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
          "description": "Unsigned 64-bit JSON counter/budget; encoded as canonical decimal string."
        }
      }
    },
    "preparePins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedAttempt",
        "routeProjection",
        "requestPins",
        "contextSelection",
        "profileSelection"
      ],
      "properties": {
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "routeProjection": {
          "$ref": "#/$defs/routeProjection"
        },
        "requestPins": {
          "$ref": "#/$defs/requestPins"
        },
        "contextSelection": {
          "type": "object"
        },
        "profileSelection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profileId",
            "revision"
          ],
          "properties": {
            "profileId": {
              "$ref": "#/$defs/id"
            },
            "revision": {
              "$ref": "#/$defs/revision"
            }
          }
        }
      }
    },
    "PrepareRequest": {
      "$ref": "#/$defs/preparePins"
    },
    "PrepareResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requestID",
        "requestSequence",
        "contextSelectionDigest",
        "providerID",
        "modelID",
        "harnessID",
        "routeID",
        "endpointRevision",
        "credentialLeaseRef",
        "requestDigest",
        "transportRequestDigest",
        "operationDigest",
        "revision",
        "managedAttempt",
        "guardChallenge"
      ],
      "properties": {
        "status": {
          "enum": [
            "PREPARED",
            "REPLAY",
            "UNAVAILABLE"
          ]
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "requestSequence": {
          "$ref": "#/$defs/revision"
        },
        "contextSelectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "providerID": {
          "$ref": "#/$defs/id"
        },
        "modelID": {
          "$ref": "#/$defs/id"
        },
        "harnessID": {
          "$ref": "#/$defs/id"
        },
        "routeID": {
          "$ref": "#/$defs/id"
        },
        "endpointRevision": {
          "$ref": "#/$defs/digest"
        },
        "credentialLeaseRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "guardChallenge": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/guardChallenge"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNAVAILABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "providerRequestID"
                  ]
                },
                {
                  "required": [
                    "prepareDigest"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "providerRequestID",
              "prepareDigest"
            ]
          }
        }
      ]
    },
    "BeginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedAttempt",
        "providerRequestID",
        "prepareDigest",
        "routeProjection",
        "requestPins"
      ],
      "properties": {
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "routeProjection": {
          "$ref": "#/$defs/routeProjection"
        },
        "requestPins": {
          "$ref": "#/$defs/requestPins"
        }
      }
    },
    "ResolveApprovalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedAttempt",
        "routeProjection",
        "requestPins",
        "challengeID",
        "effectID",
        "allow"
      ],
      "properties": {
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "routeProjection": {
          "$ref": "#/$defs/routeProjection"
        },
        "requestPins": {
          "$ref": "#/$defs/requestPins"
        },
        "challengeID": {
          "$ref": "#/$defs/id"
        },
        "effectID": {
          "$ref": "#/$defs/id"
        },
        "allow": {
          "type": "boolean"
        }
      }
    },
    "ResolveApprovalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "challengeID",
        "effectID",
        "providerRequestID",
        "prepareDigest",
        "revision",
        "managedAttempt"
      ],
      "properties": {
        "status": {
          "enum": [
            "APPROVED",
            "DENIED"
          ]
        },
        "challengeID": {
          "$ref": "#/$defs/id"
        },
        "effectID": {
          "$ref": "#/$defs/id"
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        }
      }
    },
    "BeginBaseResponse": {
      "type": "object",
      "required": [
        "status",
        "sendAuthorization",
        "revision",
        "managedAttempt",
        "requestID",
        "requestSequence",
        "contextSelectionDigest",
        "providerID",
        "modelID",
        "harnessID",
        "routeID",
        "endpointRevision",
        "credentialLeaseRef",
        "guardChallengeID",
        "effectID",
        "capabilityLeaseDigest",
        "authorizationBindingDigest",
        "requestDigest",
        "transportRequestDigest",
        "operationDigest"
      ],
      "properties": {
        "status": {
          "enum": [
            "DISPATCHING",
            "REPLAY"
          ]
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "dispatchDigest": {
          "$ref": "#/$defs/digest"
        },
        "sendAuthorization": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          ]
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "requestSequence": {
          "$ref": "#/$defs/revision"
        },
        "contextSelectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "providerID": {
          "$ref": "#/$defs/id"
        },
        "modelID": {
          "$ref": "#/$defs/id"
        },
        "harnessID": {
          "$ref": "#/$defs/id"
        },
        "routeID": {
          "$ref": "#/$defs/id"
        },
        "endpointRevision": {
          "$ref": "#/$defs/digest"
        },
        "credentialLeaseRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "guardChallengeID": {
          "$ref": "#/$defs/id"
        },
        "effectID": {
          "$ref": "#/$defs/id"
        },
        "capabilityLeaseDigest": {
          "$ref": "#/$defs/digest"
        },
        "authorizationBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        }
      }
    },
    "BeginUnavailableResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sendAuthorization",
        "revision",
        "managedAttempt",
        "requestID",
        "requestSequence",
        "contextSelectionDigest",
        "providerID",
        "modelID",
        "harnessID",
        "routeID",
        "endpointRevision",
        "credentialLeaseRef",
        "guardChallengeID",
        "effectID",
        "capabilityLeaseDigest",
        "authorizationBindingDigest",
        "requestDigest",
        "transportRequestDigest",
        "operationDigest"
      ],
      "properties": {
        "status": {
          "const": "UNAVAILABLE"
        },
        "sendAuthorization": {
          "type": "null"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "requestSequence": {
          "$ref": "#/$defs/revision"
        },
        "contextSelectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "providerID": {
          "$ref": "#/$defs/id"
        },
        "modelID": {
          "$ref": "#/$defs/id"
        },
        "harnessID": {
          "$ref": "#/$defs/id"
        },
        "routeID": {
          "$ref": "#/$defs/id"
        },
        "endpointRevision": {
          "$ref": "#/$defs/digest"
        },
        "credentialLeaseRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "guardChallengeID": {
          "type": "null"
        },
        "effectID": {
          "type": "null"
        },
        "capabilityLeaseDigest": {
          "type": "null"
        },
        "authorizationBindingDigest": {
          "type": "null"
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        }
      }
    },
    "BeginReplayResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/BeginBaseResponse"
        },
        {
          "required": [
            "providerRequestID",
            "prepareDigest",
            "dispatchDigest"
          ],
          "properties": {
            "status": {
              "const": "REPLAY"
            },
            "sendAuthorization": {
              "type": "null"
            }
          },
          "not": {
            "required": [
              "secretUseContext"
            ]
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "BeginFreshResponse": {
      "allOf": [
        {
          "$ref": "#/$defs/BeginBaseResponse"
        },
        {
          "required": [
            "providerRequestID",
            "prepareDigest",
            "dispatchDigest",
            "secretUseContext"
          ],
          "properties": {
            "status": {
              "const": "DISPATCHING"
            },
            "sendAuthorization": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "secretUseContext": {
              "$ref": "#/$defs/secretUseContext"
            }
          },
          "unevaluatedProperties": false
        }
      ]
    },
    "SettleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedAttempt",
        "providerRequestID",
        "prepareDigest",
        "dispatchDigest",
        "transportRequestDigest",
        "operationDigest",
        "assistantEntryID",
        "stepFinishIndex",
        "responseDigest",
        "usageProvenance"
      ],
      "properties": {
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "dispatchDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        },
        "assistantEntryID": {
          "$ref": "#/$defs/id"
        },
        "stepFinishIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "responseDigest": {
          "$ref": "#/$defs/digest"
        },
        "usageProvenance": {
          "type": "object"
        }
      }
    },
    "SettleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "providerRequestID",
        "prepareDigest",
        "dispatchDigest",
        "assistantEntryID",
        "stepFinishIndex",
        "responseDigest",
        "usageDigest",
        "requestID",
        "requestSequence",
        "contextSelectionDigest",
        "providerID",
        "modelID",
        "harnessID",
        "routeID",
        "endpointRevision",
        "credentialLeaseRef",
        "requestDigest",
        "transportRequestDigest",
        "operationDigest",
        "revision",
        "managedAttempt"
      ],
      "properties": {
        "status": {
          "enum": [
            "SETTLED",
            "REPLAY"
          ]
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "dispatchDigest": {
          "$ref": "#/$defs/digest"
        },
        "assistantEntryID": {
          "$ref": "#/$defs/id"
        },
        "stepFinishIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "responseDigest": {
          "$ref": "#/$defs/digest"
        },
        "usageDigest": {
          "$ref": "#/$defs/digest"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "requestSequence": {
          "$ref": "#/$defs/revision"
        },
        "contextSelectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "providerID": {
          "$ref": "#/$defs/id"
        },
        "modelID": {
          "$ref": "#/$defs/id"
        },
        "harnessID": {
          "$ref": "#/$defs/id"
        },
        "routeID": {
          "$ref": "#/$defs/id"
        },
        "endpointRevision": {
          "$ref": "#/$defs/digest"
        },
        "credentialLeaseRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        }
      }
    },
    "UnknownRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managedAttempt",
        "providerRequestID",
        "prepareDigest",
        "dispatchDigest",
        "transportRequestDigest",
        "operationDigest",
        "reasonCode"
      ],
      "properties": {
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "dispatchDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        }
      }
    },
    "UnknownResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "providerRequestID",
        "prepareDigest",
        "dispatchDigest",
        "reasonCode",
        "requestID",
        "requestSequence",
        "contextSelectionDigest",
        "providerID",
        "modelID",
        "harnessID",
        "routeID",
        "endpointRevision",
        "credentialLeaseRef",
        "requestDigest",
        "transportRequestDigest",
        "operationDigest",
        "revision",
        "managedAttempt"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "REPLAY"
          ]
        },
        "providerRequestID": {
          "$ref": "#/$defs/id"
        },
        "prepareDigest": {
          "$ref": "#/$defs/digest"
        },
        "dispatchDigest": {
          "$ref": "#/$defs/digest"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "requestSequence": {
          "$ref": "#/$defs/revision"
        },
        "contextSelectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "providerID": {
          "$ref": "#/$defs/id"
        },
        "modelID": {
          "$ref": "#/$defs/id"
        },
        "harnessID": {
          "$ref": "#/$defs/id"
        },
        "routeID": {
          "$ref": "#/$defs/id"
        },
        "endpointRevision": {
          "$ref": "#/$defs/digest"
        },
        "credentialLeaseRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "requestDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportRequestDigest": {
          "$ref": "#/$defs/digest"
        },
        "operationDigest": {
          "$ref": "#/$defs/operationDigest"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "managedAttempt": {
          "$ref": "#/$defs/managedAttempt"
        }
      }
    },
    "managedAttempt": {
      "type": "object",
      "description": "Exact ManagedAttemptScopeV1 from kernel/src/protocol.rs, including requestID, requestSequence, contextSelectionDigest, permissionScopeDigest and worktreeTarget when required by the live provider boundary. The HostKernel independently resolves every field against the authenticated current Attempt.",
      "additionalProperties": false,
      "required": [
        "goalID",
        "runID",
        "taskID",
        "attemptID",
        "ownerEpoch",
        "expectedManagedRevision",
        "locationID",
