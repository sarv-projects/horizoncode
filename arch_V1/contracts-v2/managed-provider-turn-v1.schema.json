          "$ref": "#/$defs/digest"
        },
        "effectiveMaxTokens": {
          "$ref": "#/$defs/revision"
        },
        "remainingTokens": {
          "$ref": "#/$defs/revision"
        },
        "requestID": {
          "$ref": "#/$defs/id"
        },
        "requestSequence": {
          "$ref": "#/$defs/revision"
        },
        "contextSelectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "worktreeTarget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worktreeID",
            "worktreeBaseRevision",
            "worktreePoolRevision",
            "locationID",
            "workspaceID",
            "workspaceRef",
            "canonicalRoot",
            "workspaceRevision"
          ],
          "properties": {
            "worktreeID": {
              "$ref": "#/$defs/id"
            },
            "worktreeBaseRevision": {
              "$ref": "#/$defs/id"
            },
            "worktreePoolRevision": {
              "$ref": "#/$defs/revision"
            },
            "locationID": {
              "$ref": "#/$defs/id"
            },
            "workspaceID": {
              "$ref": "#/$defs/id"
            },
            "workspaceRef": {
              "$ref": "#/$defs/id"
            },
            "canonicalRoot": {
              "$ref": "#/$defs/id"
            },
            "workspaceRevision": {
              "$ref": "#/$defs/id"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "requestID"
            ]
          },
          "then": {
            "required": [
              "requestSequence",
              "contextSelectionDigest"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "requestSequence"
                  ]
                },
                {
                  "required": [
                    "contextSelectionDigest"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
