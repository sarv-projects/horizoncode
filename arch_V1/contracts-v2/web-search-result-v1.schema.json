{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebSearchResultV1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "routeClass": {
      "enum": [
        "direct_search",
        "grounded_model_search"
      ]
    },
    "retrievedAt": {
      "type": "string",
      "minLength": 1
    },
    "costClass": {
      "enum": [
        "free",
        "paid",
        "trial",
        "unknown"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "url",
          "title",
          "snippet"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "providerId",
    "routeClass",
    "retrievedAt",
    "costClass",
    "results"
  ],
  "additionalProperties": false
}
