{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceArtifactV1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "ownerRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "mime": {
      "type": "string",
      "minLength": 1
    },
    "byteCount": {
      "type": "integer",
      "minimum": 0
    },
    "fidelity": {
      "enum": [
        "full",
        "head_tail_sample",
        "failed"
      ]
    },
    "droppedByteCount": {
      "type": "integer",
      "minimum": 0
    },
    "retentionClass": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "artifactId",
    "ownerRef",
    "sourceRevision",
    "sha256",
    "mime",
    "byteCount",
    "fidelity",
    "droppedByteCount",
    "retentionClass"
  ],
  "additionalProperties": false
}
