{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FigureBlockV1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "figureId": {
      "type": "string",
      "minLength": 1
    },
    "messagePartId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
      "description": "Unsigned 64-bit revision/epoch encoded as canonical decimal string."
    },
    "sourceDigest": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "svg",
        "mermaid",
        "chart"
      ]
    },
    "status": {
      "enum": [
        "open",
        "rendering",
        "ready",
        "failed",
        "closed"
      ]
    },
    "rendererVersion": {
      "type": "string",
      "minLength": 1
    },
    "themeEpoch": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
      "description": "Unsigned 64-bit revision/epoch encoded as canonical decimal string."
    },
    "geometryEpoch": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
      "description": "Unsigned 64-bit revision/epoch encoded as canonical decimal string."
    },
    "altText": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceArtifactRef": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "figureId",
    "messagePartId",
    "sourceRevision",
    "sourceDigest",
    "kind",
    "status",
    "rendererVersion",
    "themeEpoch",
    "geometryEpoch"
  ],
  "additionalProperties": false
}
