{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopActionV1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "targetRef": {
      "type": "string",
      "minLength": 1
    },
    "expectedGeneration": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64",
      "description": "Unsigned 64-bit JSON counter/budget; encoded as canonical decimal string."
    },
    "action": {
      "enum": [
        "pointer_move",
        "click",
        "scroll",
        "key",
        "type",
        "focus",
        "clipboard_read",
        "clipboard_write",
        "snapshot",
        "ax_query"
      ]
    },
    "arguments": {
      "type": "object",
      "additionalProperties": true
    },
    "effectContextRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000,
      "description": "Fixed V1 bound (600000) keeps this value exactly representable as a JSON number."
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "backend",
    "targetRef",
    "expectedGeneration",
    "action",
    "arguments",
    "deadlineMs"
  ],
  "additionalProperties": false
}
