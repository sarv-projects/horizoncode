{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizoncode.dev/contracts/execution-launch-profile-v1.schema.json",
  "title": "HorizonCode authenticated ExecutionHost launch profile v1",
  "description": "Private Core Config to HostKernel projection plus the logical profile reference carried by P4. The definition is not a public API and does not itself authorize process launch.",
  "oneOf": [
    {
      "$ref": "#/$defs/ExecutionLaunchProfileDefinitionV1"
    },
    {
      "$ref": "#/$defs/ExecutionLaunchProfileRefV1"
    },
    {
      "$ref": "#/$defs/HostProcessRefV1"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "ProcessIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "ProfileIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "DecimalU64": {
      "$ref": "horizon://schemas/wire-primitives-v1#/$defs/DecimalU64"
    },
    "ExecutionLaunchProfileDefinitionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profileId",
        "revision",
        "kind",
        "executableSelector",
        "argv",
        "workingDirectoryPolicy",
        "environmentPolicy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "profileId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "horizon://schemas/wire-primitives-v1#/$defs/PositiveDecimalU64"
        },
        "kind": {
          "enum": [
            "lsp",
            "dap",
            "repl"
          ]
        },
        "executableSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "argv": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          }
        },
        "dapPolicy": {
          "description": "Immutable DAP-only policy. Omission and explicit false both deny evaluation; either representation remains distinct in the profile digest.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowEvaluate"
          ],
          "properties": {
            "allowEvaluate": {
              "type": "boolean"
            }
          }
        },
        "workingDirectoryPolicy": {
          "const": "registered_location_root"
        },
        "environmentPolicy": {
          "const": "sanitized_host"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dap"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {},
          "else": {
            "not": {
              "required": [
                "dapPolicy"
              ]
            }
          }
        }
      ]
    },
    "ExecutionLaunchProfileRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "revision",
        "profileDigest"
      ],
      "properties": {
        "profileId": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "horizon://schemas/wire-primitives-v1#/$defs/PositiveDecimalU64"
        },
        "profileDigest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "HostProcessRefV1": {
      "description": "HostKernel-minted process identity. It intentionally contains no PID, executable path, argv, or process handle; every field is checked against HostKernel-retained state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionID",
        "generation",
        "ownerEpoch",
        "kind",
        "profileID",
        "profileRevision",
        "profileDigest",
        "executableDigest"
      ],
      "properties": {
        "executionID": {
          "$ref": "#/$defs/ProcessIdentifier"
        },
        "generation": {
          "$ref": "horizon://schemas/wire-primitives-v1#/$defs/PositiveDecimalU64"
        },
        "ownerEpoch": {
          "$ref": "horizon://schemas/wire-primitives-v1#/$defs/PositiveDecimalU64"
        },
        "kind": {
          "enum": [
            "terminal_run",
          "external_editor",
            "language_server",
            "debug_adapter",
            "interpreter",
            "managed_verifier"
          ]
        },
        "profileID": {
          "$ref": "#/$defs/ProfileIdentifier"
        },
        "profileRevision": {
          "$ref": "horizon://schemas/wire-primitives-v1#/$defs/PositiveDecimalU64"
        },
        "profileDigest": {
          "$ref": "#/$defs/Digest"
        },
        "executableDigest": {
          "$ref": "#/$defs/Digest"
        }
      }
    }
  }
}
