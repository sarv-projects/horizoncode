{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizoncode.dev/contracts/execution-launch-profile-v1.schema.json",
  "title": "HorizonCode authenticated ExecutionHost launch profile v1",
  "description": "Private Core Config to HostKernel projection plus the logical profile reference carried by P4. The definition is not a public API and does not itself authorize process launch.",
  "oneOf": [
    { "$ref": "#/$defs/ExecutionLaunchProfileDefinitionV1" },
    { "$ref": "#/$defs/ExecutionLaunchProfileRefV1" },
    { "$ref": "#/$defs/HostProcessRefV1" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "ProcessIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "DecimalU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical unsigned decimal string; decoders must reject values greater than 18446744073709551615."
    },
    "ExecutionLaunchProfileDefinitionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profileId",
        "revision",
        "kind",
        "executableSelector",
        "argv",
        "workingDirectoryPolicy",
        "environmentPolicy"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "profileId": { "$ref": "#/$defs/Identifier" },
        "revision": {
          "allOf": [
            { "$ref": "#/$defs/DecimalU64" },
            { "not": { "const": "0" } }
          ]
        },
        "kind": { "enum": ["lsp", "dap", "repl"] },
        "executableSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "argv": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          }
        },
        "workingDirectoryPolicy": { "const": "registered_location_root" },
        "environmentPolicy": { "const": "sanitized_host" }
      }
    },
    "ExecutionLaunchProfileRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision", "profileDigest"],
      "properties": {
        "profileId": { "$ref": "#/$defs/Identifier" },
        "revision": {
          "allOf": [
            { "$ref": "#/$defs/DecimalU64" },
            { "not": { "const": "0" } }
          ]
        },
        "profileDigest": { "$ref": "#/$defs/Digest" }
      }
    },
    "HostProcessRefV1": {
      "description": "HostKernel-minted process identity. It intentionally contains no PID, executable path, argv, or process handle; every field is checked against HostKernel-retained state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionID",
        "generation",
        "ownerEpoch",
        "kind",
        "profileID",
        "profileRevision",
        "profileDigest",
        "executableDigest"
      ],
      "properties": {
        "executionID": { "$ref": "#/$defs/ProcessIdentifier" },
        "generation": {
          "allOf": [
            { "$ref": "#/$defs/DecimalU64" },
            { "not": { "const": "0" } }
          ]
        },
        "ownerEpoch": {
          "allOf": [
            { "$ref": "#/$defs/DecimalU64" },
            { "not": { "const": "0" } }
          ]
        },
        "kind": {
          "enum": ["terminal_run", "language_server", "debug_adapter", "interpreter", "managed_verifier"]
        },
        "profileID": { "$ref": "#/$defs/ProcessIdentifier" },
        "profileRevision": {
          "allOf": [
            { "$ref": "#/$defs/DecimalU64" },
            { "not": { "const": "0" } }
          ]
        },
        "profileDigest": { "$ref": "#/$defs/Digest" },
        "executableDigest": { "$ref": "#/$defs/Digest" }
      }
    }
  }
}
