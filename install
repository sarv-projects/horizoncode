#!/usr/bin/env bash
set -euo pipefail

# Preserve the existing vendor-era install directory for in-place CLI upgrades;
# the public command names both resolve to the same installed candidate/runtime.
COMMAND=horizoncode
ALIAS=hzcode

MUTED='\033[0;2m'
RED='\033[0;31m'
NC='\033[0m'

usage() {
    cat <<'EOF'
HorizonCode Installer

Installs a local Linux CLI candidate. Both 'horizoncode' and 'hzcode' start the
same CLI entrypoint. Remote installation is disabled until a release signing
trust policy is approved.

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Select a version (remote installation unavailable)
    -b, --binary <path>     Install from a local executable candidate
        --sha256 <hex>      Required: verify candidate SHA-256 (64 hex characters)
        --no-modify-path    Don't modify shell config files
        --dry-run           Validate the candidate and print the plan; write nothing

HORIZONCODE_INSTALL_DIR accepts ASCII letters, digits, spaces, '_', '.', '/', and '-'.
Control characters and shell metacharacters are rejected before changing files.

Example:
    ./install --binary /path/to/horizoncode --sha256 <verified-64-hex-digest>
EOF
}

binary_path=""
no_modify_path=false
dry_run=false
requested_version=""
expected_sha256=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --version requires a version argument" >&2
                exit 1
            fi
            requested_version="$2"
            shift 2
            ;;
        -b|--binary)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --binary requires a path argument" >&2
                exit 1
            fi
            binary_path="$2"
            shift 2
            ;;
        --sha256)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --sha256 requires a 64-character hexadecimal digest argument" >&2
                exit 1
            fi
            expected_sha256="$2"
            shift 2
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        *)
            echo "Error: unknown option '$1'" >&2
            exit 1
            ;;
    esac
done

raw_os=$(uname -s)
case "$raw_os" in
    Linux*) ;;
    *)
        echo -e "${RED}HorizonCode V1 installer supports Linux/WSL only; native Windows is unavailable and macOS is out of scope.${NC}" >&2
        exit 1
        ;;
esac

if [[ -n "$requested_version" && -n "$binary_path" ]]; then
    echo "Error: --version cannot be combined with --binary; version selection is unavailable until signed remote installs are approved." >&2
    exit 1
fi

if [[ -n "$expected_sha256" && -z "$binary_path" ]]; then
    echo "Error: --sha256 requires --binary; remote and versioned installation remains unavailable until signed remote installs are approved." >&2
    exit 1
fi

if [[ -n "$expected_sha256" && ! "$expected_sha256" =~ ^[0-9a-fA-F]{64}$ ]]; then
    echo "Error: --sha256 must be exactly 64 hexadecimal characters." >&2
    exit 1
fi

if [[ -z "$binary_path" ]]; then
    echo -e "${RED}Network installation is unavailable until the HorizonCode release signing trust policy is approved.${NC}" >&2
    if [[ -n "$requested_version" ]]; then
        echo -e "${MUTED}Requested version: ${requested_version}${NC}" >&2
    fi
    echo -e "${MUTED}Use --binary only with a locally built candidate during release acceptance.${NC}" >&2
    exit 1
fi

if [[ ! -f "$binary_path" || ! -x "$binary_path" || -L "$binary_path" ]]; then
    echo -e "${RED}Error: Binary must be a regular executable file: ${binary_path}${NC}" >&2
    exit 1
fi

if [[ -z "$expected_sha256" ]]; then
    echo -e "${RED}Error: --sha256 is required for every local binary install; unsigned local candidates must be pinned explicitly.${NC}" >&2
    exit 1
fi

# The mandatory digest check is offline by design: it reads only the local
# candidate and fails closed before any install state is created.
compute_sha256() {
    local output
    if command -v sha256sum >/dev/null 2>&1; then
        output=$(sha256sum -- "$1") || return 1
    elif command -v shasum >/dev/null 2>&1; then
        output=$(shasum -a 256 -- "$1") || return 1
    else
        return 1
    fi
    output=${output%%[[:space:]]*}
    [[ "$output" =~ ^[[:xdigit:]]{64}$ ]] || return 1
    printf '%s' "$output"
}

elf_machine_id() {
    local path=$1
    local magic class byte_order machine

    if ! command -v od >/dev/null 2>&1; then
        return 1
    fi
    magic=$(od -An -tx1 -N4 -- "$path" | tr -d '[:space:]')
    [[ "$magic" == "7f454c46" ]] || return 1
    class=$(od -An -tu1 -j4 -N1 -- "$path" | tr -d '[:space:]')
    byte_order=$(od -An -tu1 -j5 -N1 -- "$path" | tr -d '[:space:]')
    [[ "$class" == "2" && "$byte_order" == "1" ]] || return 1
    machine=$(od -An -tu2 -j18 -N2 -- "$path" | tr -d '[:space:]')
    [[ "$machine" =~ ^[0-9]+$ ]] || return 1
    printf '%s' "$machine"
}

validate_candidate_architecture() {
    local path=$1
    local host_machine expected_machine observed_machine first_line interpreter extra

    host_machine=$(uname -m)
    case "$host_machine" in
        x86_64|amd64) expected_machine=62 ;;
        aarch64|arm64) expected_machine=183 ;;
        *)
            echo -e "${RED}Error: Linux architecture '${host_machine}' is not a supported V1 installer target.${NC}" >&2
            return 1
            ;;
    esac

    observed_machine=$(elf_machine_id "$path") || observed_machine=""
    if [[ -z "$observed_machine" ]]; then
        if ! IFS= read -r first_line < "$path" || [[ "$first_line" != '#!'* ]]; then
            echo -e "${RED}Error: Candidate is not a supported ELF executable or direct-interpreter script.${NC}" >&2
            return 1
        fi
        read -r interpreter extra <<< "${first_line#\#!}"
        if [[ -z "$interpreter" || -n "${extra:-}" || "$interpreter" != /* || "${interpreter##*/}" == "env" || ! -f "$interpreter" || ! -x "$interpreter" ]]; then
            echo -e "${RED}Error: Candidate script must use one absolute, executable ELF interpreter without env indirection or extra arguments.${NC}" >&2
            return 1
        fi
        observed_machine=$(elf_machine_id "$interpreter") || observed_machine=""
        if [[ -z "$observed_machine" ]]; then
            echo -e "${RED}Error: Candidate script interpreter is not a supported little-endian ELF executable.${NC}" >&2
            return 1
        fi
    fi

    if [[ "$observed_machine" != "$expected_machine" ]]; then
        echo -e "${RED}Error: Candidate architecture does not match host architecture '${host_machine}' (ELF machine ${observed_machine}).${NC}" >&2
        return 1
    fi
}

verified_sha256=""
if ! verified_sha256=$(compute_sha256 "$binary_path"); then
    echo -e "${RED}Error: no sha256sum/shasum tool is available to verify the candidate digest.${NC}" >&2
    exit 1
fi
if [[ "${verified_sha256,,}" != "${expected_sha256,,}" ]]; then
    echo -e "${RED}Error: candidate SHA-256 mismatch; refusing to install.${NC}" >&2
    echo "  expected: ${expected_sha256,,}" >&2
    echo "  actual:   ${verified_sha256}" >&2
    exit 1
fi
if ! validate_candidate_architecture "$binary_path"; then
    exit 1
fi

INSTALL_DIR=${HORIZONCODE_INSTALL_DIR:-$HOME/.opencode/bin}
validate_install_dir() {
    local value=$1
    if [[ -z "$value" || "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
        echo "Error: Install directory must be non-empty and contain no CR/LF characters." >&2
        return 1
    fi
    if [[ "$value" =~ [^a-zA-Z0-9_./\ -] ]]; then
        echo "Error: Install directory may contain only ASCII letters, digits, spaces, '_', '.', '/', and '-'." >&2
        return 1
    fi
}

format_install_path_command() {
    local shell_name=$1
    local value=$2
    case "$shell_name" in
        fish) printf "fish_add_path '%s'" "$value" ;;
        *) printf "export PATH='%s':\$PATH" "$value" ;;
    esac
}

if ! validate_install_dir "$INSTALL_DIR"; then
    exit 1
fi

if [[ -L "$INSTALL_DIR" ]]; then
    echo -e "${RED}Error: Install directory must not be a symlink: ${INSTALL_DIR}${NC}" >&2
    exit 1
fi

for destination in "$COMMAND" "$ALIAS"; do
    current="${INSTALL_DIR}/${destination}"
    if [[ -d "$current" && ! -L "$current" ]]; then
        echo -e "${RED}Error: Install destination must not be a directory: ${current}${NC}" >&2
        exit 1
    fi
done

if [[ "$dry_run" == true ]]; then
    echo "Dry run: no files will be written."
    echo "  candidate: ${binary_path}"
    if [[ -n "$verified_sha256" ]]; then
        echo "  sha256: verified ${verified_sha256}"
    fi
    echo "  canonical: ${INSTALL_DIR}/${COMMAND}"
    echo "  short:     ${INSTALL_DIR}/${ALIAS} -> ${COMMAND}"
    if [[ "$no_modify_path" == true ]]; then
        echo "  shell path: unchanged (--no-modify-path)"
    else
        echo "  shell path: would add ${INSTALL_DIR} to the login shell configuration when absent"
    fi
    echo "  network install/publication/signing: unavailable"
    exit 0
fi

mkdir -p "$INSTALL_DIR"

# Copy into the destination filesystem, then replace the canonical path with a
# single rename. A failed copy/chmod leaves the previous install untouched.
staged=$(mktemp "${INSTALL_DIR}/.horizoncode-install.XXXXXX")
if ! cp -- "$binary_path" "$staged" || ! chmod 755 "$staged"; then
    rm -f -- "$staged"
    exit 1
fi
staged_sha256=""
if ! staged_sha256=$(compute_sha256 "$staged") || [[ "${staged_sha256,,}" != "${expected_sha256,,}" ]]; then
    rm -f -- "$staged"
    echo -e "${RED}Error: staged candidate SHA-256 mismatch; refusing activation.${NC}" >&2
    exit 1
fi

# Keep the short command a symlink to the canonical executable. The copy
# fallback is a hard link to the staged candidate so both names initially
# refer to the same inode and cannot differ at installation time.
alias_stage=$(mktemp "${INSTALL_DIR}/.${ALIAS}.install.XXXXXX")
rm -f -- "$alias_stage"
if ! ln -s "$COMMAND" "$alias_stage" 2>/dev/null; then
    if ! ln -- "$staged" "$alias_stage"; then
        rm -f -- "$staged" "$alias_stage"
        echo -e "${RED}Error: Could not create the shared hzcode entrypoint.${NC}" >&2
        exit 1
    fi
fi

# Prepare recoverable snapshots before replacing either public command. The
# two renames cannot form one filesystem transaction; retaining these snapshots
# lets us restore the old canonical command if alias activation fails.
canonical_path="${INSTALL_DIR}/${COMMAND}"
alias_path="${INSTALL_DIR}/${ALIAS}"
canonical_backup=""
alias_backup=""
cleanup_install_stages() {
    rm -f -- "$staged" "$alias_stage"
    for backup in "$canonical_backup" "$alias_backup"; do
        if [[ -n "$backup" ]]; then
            rm -f -- "$backup"
        fi
    done
}
if [[ -e "$canonical_path" || -L "$canonical_path" ]]; then
    canonical_backup=$(mktemp "${INSTALL_DIR}/.${COMMAND}.backup.XXXXXX")
    if ! cp -a -- "$canonical_path" "$canonical_backup"; then
        cleanup_install_stages
        echo -e "${RED}Error: Could not preserve the existing ${COMMAND} command.${NC}" >&2
        exit 1
    fi
fi
if [[ -e "$alias_path" || -L "$alias_path" ]]; then
    alias_backup=$(mktemp "${INSTALL_DIR}/.${ALIAS}.backup.XXXXXX")
    if ! cp -a -- "$alias_path" "$alias_backup"; then
        cleanup_install_stages
        echo -e "${RED}Error: Could not preserve the existing ${ALIAS} command.${NC}" >&2
        exit 1
    fi
fi

if ! mv -f -- "$staged" "${INSTALL_DIR}/${COMMAND}"; then
    cleanup_install_stages
    exit 1
fi
if ! mv -f -- "$alias_stage" "${INSTALL_DIR}/${ALIAS}"; then
    restore_failed=false
    if [[ -n "$canonical_backup" ]]; then
        if ! mv -f -- "$canonical_backup" "$canonical_path"; then
            restore_failed=true
        fi
    elif ! rm -f -- "$canonical_path"; then
        restore_failed=true
    fi
    if [[ -n "$alias_backup" ]]; then
        if ! mv -f -- "$alias_backup" "$alias_path"; then
            restore_failed=true
        fi
    elif ! rm -f -- "$alias_path"; then
        restore_failed=true
    fi
    rm -f -- "$alias_stage"
    if [[ "$restore_failed" == true ]]; then
        echo -e "${RED}Error: Alias activation failed and full rollback could not be restored; recovery copies: ${canonical_backup} ${alias_backup}${NC}" >&2
        exit 1
    fi
    cleanup_install_stages
    echo -e "${RED}Error: Could not activate the ${ALIAS} command; prior ${COMMAND} was restored.${NC}" >&2
    exit 1
fi
cleanup_install_stages

add_to_path() {
    local config_file=$1
    local command=$2
    if grep -Fxq "$command" "$config_file"; then
        return 0
    fi
    if [[ -w "$config_file" ]]; then
        printf '\n# HorizonCode CLI\n%s\n' "$command" >> "$config_file"
        return 0
    fi
    echo "Add this to your shell configuration: $command" >&2
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
current_shell=$(basename "${SHELL:-sh}")
case "$current_shell" in
    fish) config_files=("$HOME/.config/fish/config.fish") ;;
    zsh) config_files=("${ZDOTDIR:-$HOME}/.zshrc" "${ZDOTDIR:-$HOME}/.zshenv" "$XDG_CONFIG_HOME/zsh/.zshrc" "$XDG_CONFIG_HOME/zsh/.zshenv") ;;
    bash) config_files=("$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$XDG_CONFIG_HOME/bash/.bashrc" "$XDG_CONFIG_HOME/bash/.bash_profile") ;;
    ash|sh) config_files=("$HOME/.ashrc" "$HOME/.profile") ;;
    *) config_files=("$HOME/.bashrc" "$HOME/.profile") ;;
esac

if [[ "$no_modify_path" != true && ":${PATH:-}:" != *":${INSTALL_DIR}:"* ]]; then
    config_file=""
    for file in "${config_files[@]}"; do
        if [[ -f "$file" ]]; then
            config_file="$file"
            break
        fi
    done
    if [[ -n "$config_file" ]]; then
        add_to_path "$config_file" "$(format_install_path_command "$current_shell" "$INSTALL_DIR")"
    else
        echo "Add $INSTALL_DIR to PATH in your shell configuration."
    fi
fi

if [[ "${GITHUB_ACTIONS:-}" == true && -n "${GITHUB_PATH:-}" ]]; then
    append_github_path=true
    if [[ -f "$GITHUB_PATH" ]]; then
        while IFS= read -r github_path_entry || [[ -n "$github_path_entry" ]]; do
            if [[ "$github_path_entry" == "$INSTALL_DIR" ]]; then
                append_github_path=false
                break
            fi
        done < "$GITHUB_PATH"
    fi
    if [[ "$append_github_path" == true ]]; then
        printf '%s\n' "$INSTALL_DIR" >> "$GITHUB_PATH"
    fi
fi

echo "Installed HorizonCode in ${INSTALL_DIR}"
echo "Both horizoncode and hzcode start the same CLI."
echo "Linux/WSL install path selected; platform acceptance is still pending. Native Windows remains unavailable."
echo "Documentation: https://github.com/sarv-projects/horizoncode/tree/main/docs"
