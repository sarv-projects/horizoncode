  "rules": {
    "rename_only_first_party_workspace_ids": true,
    "never_rename_vendor_or_upstream_ids": true,
    "pinned_snapshot_preserved": "opencode/**",
    "host_package_target": "horizoncode",
    "host_package_note": "Renaming the private host package 'opencode' to 'horizoncode' is a parent/product decision. bin/horizoncode, the hzcode alias, the compatibility opencode symlink and $HOME/.opencode paths stay; only the private workspace identity and its lock edges move.",
    "execution_note": "Every MIGRATE row must land atomically with its manifest, bun.lock importer/resolution, import specifiers and generated identifiers, followed by full horizoncode:typecheck. No isolated manifest/lock rename is safe while consumers are owned by other phases."
  },
  "facts": {
    "importer_scan_scope": "packages/** files with .ts/.tsx/.json/.md suffixes, excluding the package's own manifest, node_modules, dist, target, .turbo and .bun",
    "importer_signal": "at least one in-scope file contains '<package-id>/' (a real import specifier), so the row has coupled source consumers"
  },
