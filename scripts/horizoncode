#!/usr/bin/env bash
# HorizonCode application entry: optional .env, HostKernel, local direct provider
# credentials (any models.dev provider via env or `horizoncode providers login`), then CLI/TUI.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HZ_LIB_DIR="$ROOT/scripts/e2e/lib"
# shellcheck source=lib/cgroup-scope.sh
. "$HZ_LIB_DIR/cgroup-scope.sh"
hz_ensure_scope "$@"

ENV_FILE="$ROOT/.env"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

KERNEL_BIN="$ROOT/kernel/target/debug/hz-kernel"

# A local checkout has to be runnable with ONE command. Everything the runtime
# needs is derived here, so `bash scripts/horizoncode` behaves like an installed
# binary instead of demanding four exports the user has to know about.
if [ -f "$ROOT/.env" ] && [ -z "${HORIZONCODE_ENV_LOADED:-}" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/.env"
  set +a
  export HORIZONCODE_ENV_LOADED=1
fi

# Direct-session permission reads require a trusted principal. Locally the
# terminal is the principal; a per-machine password is enough and is stable
# across runs so sessions stay resumable.
if [ -z "${OPENCODE_SERVER_PASSWORD:-}" ]; then
  export OPENCODE_SERVER_PASSWORD="horizoncode-local-$(id -u)"
fi

if [ ! -x "$KERNEL_BIN" ]; then
  echo "horizoncode: building hz-kernel…" >&2
  (cd "$ROOT/kernel" && cargo build --bin hz-kernel)
fi

export HORIZONCODE_ALLOW_DIRECT_PROVIDER_CREDENTIALS=1
export HORIZONCODE_LOCAL_CLI=1

# E2E-only Nemotron profile pin (never overwrite real ~/.config on normal dev):
if [ "${HZ_E2E_BOOTSTRAP_NEMOTRON:-0}" = "1" ]; then
  export NEMOTRON_PROVIDER_ID="${NEMOTRON_PROVIDER_ID:-nvidia}"
  export NEMOTRON_MODEL_ID="${NEMOTRON_MODEL_ID:-nvidia/nemotron-3.5-super-vl-120b-a12b}"
  export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
  # shellcheck source=lib/bootstrap-horizoncode-config.sh
  . "$HZ_LIB_DIR/bootstrap-horizoncode-config.sh"
  hz_bootstrap_horizoncode_config
fi

cd "$ROOT"
# The runtime resolves the HostKernel through these two variables. Without them
# the direct-session permission RPC answers 503 "HostKernel ... unavailable", the
# requested posture silently falls back, and the turn dies with a 500. The TUI
# runs its server in a Worker, so this has to be environment, not globalThis.
if [ -z "${OPENCODE_HOST_KERNEL_ASSET:-}" ] && [ -x "$KERNEL_BIN" ]; then
  export OPENCODE_HOST_KERNEL_ASSET="$KERNEL_BIN"
fi
if [ -z "${OPENCODE_HOST_KERNEL_MANIFEST:-}" ] && [ -n "${OPENCODE_HOST_KERNEL_ASSET:-}" ]; then
  sha256="$(sha256sum "$OPENCODE_HOST_KERNEL_ASSET" | cut -d' ' -f1)"
  export OPENCODE_HOST_KERNEL_MANIFEST="{\"schemaVersion\":1,\"status\":\"available\",\"binaryName\":\"hz-kernel\",\"target\":\"linux-x64-gnu\",\"sha256\":\"$sha256\"}"
fi

# Bun resolves tsconfig (and therefore the JSX runtime) from the current
# directory, so the runtime must be launched from its own package or the TUI dies
# with "Cannot find package 'react'". Remember where the user actually was and
# open that directory when they did not name one.
HORIZONCODE_ORIGIN="$PWD"
cd "$ROOT/packages/horizoncode" || exit 1
if [ "$#" -eq 0 ]; then
  exec ./bin/horizoncode "$HORIZONCODE_ORIGIN"
fi
exec ./bin/horizoncode "$@"
