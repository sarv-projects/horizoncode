{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizoncode.dev/contracts/secret-broker-v1.schema.json",
  "title": "SecretBroker credential records V1",
  "$defs": {
    "Horizon.SecretBrokerV1.SecretMetadataV1": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "secretRef": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            },
            {
              "maxLength": 256
            },
            {
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            }
          ]
        },
        "providerId": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            },
            {
              "maxLength": 256
            },
            {
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
            }
          ]
        },
        "label": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            },
            {
              "maxLength": 256
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "NEEDS_AUTH",
            "REVOKED",
            "UNAVAILABLE"
          ]
        },
        "version": {
          "type": "integer",
          "allOf": [
            {
              "exclusiveMinimum": 0
            }
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "secretRef",
        "providerId",
        "status",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
